{
  "$defs": {
    "AuthSetting": {
      "properties": {
        "jwt_secret": {
          "default": "MODIFY_THIS_TO_RANDOM_SECURE_STRING",
          "title": "Jwt Secret",
          "type": "string"
        },
        "jwt_lifetime_seconds": {
          "default": 259200,
          "minimum": 1,
          "title": "Jwt Lifetime Seconds",
          "type": "integer"
        },
        "cookie_max_age": {
          "default": 259200,
          "minimum": 1,
          "title": "Cookie Max Age",
          "type": "integer"
        },
        "user_secret": {
          "default": "MODIFY_THIS_TO_ANOTHER_RANDOM_SECURE_STRING",
          "title": "User Secret",
          "type": "string"
        }
      },
      "title": "AuthSetting",
      "type": "object"
    },
    "CommonSetting": {
      "properties": {
        "print_sql": {
          "default": false,
          "title": "Print Sql",
          "type": "boolean"
        },
        "print_traceback": {
          "default": true,
          "title": "Print Traceback",
          "type": "boolean"
        },
        "create_initial_admin_user": {
          "default": true,
          "title": "Create Initial Admin User",
          "type": "boolean"
        },
        "initial_admin_user_username": {
          "default": "admin",
          "title": "Initial Admin User Username",
          "type": "string"
        },
        "initial_admin_user_password": {
          "default": "password",
          "title": "Initial Admin User Password",
          "type": "string"
        }
      },
      "title": "CommonSetting",
      "type": "object"
    },
    "DataSetting": {
      "properties": {
        "data_dir": {
          "default": "./data",
          "title": "Data Dir",
          "type": "string"
        },
        "database_url": {
          "default": "sqlite+aiosqlite:///data/database.db",
          "title": "Database Url",
          "type": "string"
        },
        "mongodb_url": {
          "default": "mongodb://cws:password@mongo:27017",
          "title": "Mongodb Url",
          "type": "string"
        },
        "mongodb_db_name": {
          "default": "cws",
          "title": "Mongodb Db Name",
          "type": "string"
        },
        "run_migration": {
          "default": true,
          "title": "Run Migration",
          "type": "boolean"
        },
        "max_file_upload_size": {
          "default": 104857600,
          "minimum": 0,
          "title": "Max File Upload Size",
          "type": "integer"
        }
      },
      "title": "DataSetting",
      "type": "object"
    },
    "HttpSetting": {
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8000,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "cors_allow_origins": {
          "default": [
            "http://localhost:8000",
            "http://localhost:5173",
            "http://127.0.0.1:8000",
            "http://127.0.0.1:5173"
          ],
          "items": {
            "type": "string"
          },
          "title": "Cors Allow Origins",
          "type": "array"
        }
      },
      "title": "HttpSetting",
      "type": "object"
    },
    "LogSetting": {
      "properties": {
        "console_log_level": {
          "default": "INFO",
          "enum": [
            "INFO",
            "DEBUG",
            "WARNING"
          ],
          "title": "Console Log Level",
          "type": "string"
        }
      },
      "title": "LogSetting",
      "type": "object"
    },
    "OpenaiApiChatModels": {
      "enum": [
        "gpt_3_5",
        "gpt_4"
      ],
      "title": "OpenaiApiChatModels",
      "type": "string"
    },
    "OpenaiApiSetting": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "openai_base_url": {
          "default": "https://api.openai.com/v1/",
          "title": "Openai Base Url",
          "type": "string"
        },
        "proxy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy"
        },
        "connect_timeout": {
          "default": 10,
          "minimum": 1,
          "title": "Connect Timeout",
          "type": "integer"
        },
        "read_timeout": {
          "default": 20,
          "minimum": 1,
          "title": "Read Timeout",
          "type": "integer"
        },
        "enabled_models": {
          "default": [
            "gpt_3_5",
            "gpt_4"
          ],
          "items": {
            "$ref": "#/$defs/OpenaiApiChatModels"
          },
          "title": "Enabled Models",
          "type": "array"
        },
        "model_code_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "gpt_3_5": "gpt-3.5-turbo",
            "gpt_4": "gpt-4"
          },
          "title": "Model Code Mapping",
          "type": "object"
        }
      },
      "title": "OpenaiApiSetting",
      "type": "object"
    },
    "OpenaiWebBrowserAccountSetting": {
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "cdp_url": {
          "title": "Cdp Url",
          "type": "string"
        },
        "chatgpt_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chatgpt Url"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "Weight",
          "type": "number"
        },
        "model_labels": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Model Labels",
          "type": "object"
        },
        "quota_limits": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "title": "Quota Limits",
          "type": "object"
        },
        "quota_window_seconds": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "title": "Quota Window Seconds",
          "type": "object"
        },
        "error_cooldown_seconds": {
          "default": 60,
          "maximum": 86400,
          "minimum": 5,
          "title": "Error Cooldown Seconds",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "cdp_url"
      ],
      "title": "OpenaiWebBrowserAccountSetting",
      "type": "object"
    },
    "OpenaiWebChatGPTSetting": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "transport": {
          "default": "browser",
          "enum": [
            "browser",
            "legacy_http"
          ],
          "title": "Transport",
          "type": "string"
        },
        "is_plus_account": {
          "default": true,
          "title": "Is Plus Account",
          "type": "boolean"
        },
        "enable_team_subscription": {
          "default": false,
          "title": "Enable Team Subscription",
          "type": "boolean"
        },
        "team_account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Account Id"
        },
        "chatgpt_base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chatgpt Base Url"
        },
        "browser_cdp_url": {
          "default": "http://host.docker.internal:9222",
          "title": "Browser Cdp Url",
          "type": "string"
        },
        "browser_chatgpt_url": {
          "default": "https://chatgpt.com",
          "title": "Browser Chatgpt Url",
          "type": "string"
        },
        "browser_poll_interval_ms": {
          "default": 250,
          "maximum": 5000,
          "minimum": 100,
          "title": "Browser Poll Interval Ms",
          "type": "integer"
        },
        "browser_stable_seconds": {
          "default": 1.5,
          "maximum": 30.0,
          "minimum": 0.5,
          "title": "Browser Stable Seconds",
          "type": "number"
        },
        "browser_model_labels": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "chatgpt_auto": "",
            "chatgpt_instant": "Instant",
            "chatgpt_thinking": "Thinking",
            "chatgpt_pro": "Pro"
          },
          "title": "Browser Model Labels",
          "type": "object"
        },
        "browser_accounts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OpenaiWebBrowserAccountSetting"
          },
          "title": "Browser Accounts",
          "type": "array"
        },
        "proxy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy"
        },
        "wss_proxy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wss Proxy"
        },
        "enable_arkose_endpoint": {
          "default": false,
          "title": "Enable Arkose Endpoint",
          "type": "boolean"
        },
        "arkose_endpoint_base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arkose Endpoint Base"
        },
        "common_timeout": {
          "default": 20,
          "description": "Increase this value if timeout error occurs.",
          "minimum": 1,
          "title": "Common Timeout",
          "type": "integer"
        },
        "ask_timeout": {
          "default": 600,
          "minimum": 1,
          "title": "Ask Timeout",
          "type": "integer"
        },
        "sync_conversations_on_startup": {
          "default": false,
          "title": "Sync Conversations On Startup",
          "type": "boolean"
        },
        "sync_conversations_schedule": {
          "default": false,
          "title": "Sync Conversations Schedule",
          "type": "boolean"
        },
        "sync_conversations_schedule_interval_hours": {
          "default": 12,
          "minimum": 1,
          "title": "Sync Conversations Schedule Interval Hours",
          "type": "integer"
        },
        "enabled_models": {
          "default": [
            "chatgpt_auto"
          ],
          "items": {
            "$ref": "#/$defs/OpenaiWebChatModels"
          },
          "title": "Enabled Models",
          "type": "array"
        },
        "model_code_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "chatgpt_auto": "auto",
            "chatgpt_instant": "instant",
            "chatgpt_thinking": "thinking",
            "chatgpt_pro": "pro",
            "gpt_3_5": "text-davinci-002-render-sha",
            "gpt_3_5_mobile": "text-davinci-002-render-sha-mobile",
            "gpt_4": "gpt-4",
            "gpt_4o": "gpt-4o",
            "gpt_4_mobile": "gpt-4-mobile",
            "gpt_4_browsing": "gpt-4-browsing",
            "gpt_4_plugins": "gpt-4-plugins",
            "gpt_4_code_interpreter": "gpt-4-code-interpreter",
            "gpt_4_dalle": "gpt-4-dalle"
          },
          "title": "Model Code Mapping",
          "type": "object"
        },
        "file_upload_strategy": {
          "allOf": [
            {
              "$ref": "#/$defs/OpenaiWebFileUploadStrategyOption"
            }
          ],
          "default": "browser_upload_only"
        },
        "max_completion_concurrency": {
          "default": 1,
          "minimum": 1,
          "title": "Max Completion Concurrency",
          "type": "integer"
        },
        "disable_uploading": {
          "default": true,
          "title": "Disable Uploading",
          "type": "boolean"
        }
      },
      "title": "OpenaiWebChatGPTSetting",
      "type": "object"
    },
    "OpenaiWebChatModels": {
      "enum": [
        "chatgpt_auto",
        "chatgpt_instant",
        "chatgpt_thinking",
        "chatgpt_pro",
        "gpt_3_5",
        "gpt_3_5_mobile",
        "gpt_4",
        "gpt_4o",
        "gpt_4_mobile",
        "gpt_4_browsing",
        "gpt_4_code_interpreter",
        "gpt_4_plugins",
        "gpt_4_dalle"
      ],
      "title": "OpenaiWebChatModels",
      "type": "string"
    },
    "OpenaiWebFileUploadStrategyOption": {
      "enum": [
        "server_upload_only",
        "browser_upload_only",
        "browser_upload_when_file_size_exceed"
      ],
      "title": "OpenaiWebFileUploadStrategyOption",
      "type": "string"
    },
    "StatsSetting": {
      "properties": {
        "ask_stats_ttl": {
          "default": 7776000,
          "title": "Ask Stats Ttl",
          "type": "integer"
        },
        "request_stats_ttl": {
          "default": 2592000,
          "title": "Request Stats Ttl",
          "type": "integer"
        },
        "request_stats_filter_keywords": {
          "default": [
            "/status"
          ],
          "items": {
            "type": "string"
          },
          "title": "Request Stats Filter Keywords",
          "type": "array"
        }
      },
      "title": "StatsSetting",
      "type": "object"
    }
  },
  "properties": {
    "openai_web": {
      "allOf": [
        {
          "$ref": "#/$defs/OpenaiWebChatGPTSetting"
        }
      ],
      "default": {
        "enabled": true,
        "transport": "browser",
        "is_plus_account": true,
        "enable_team_subscription": false,
        "team_account_id": null,
        "chatgpt_base_url": null,
        "browser_cdp_url": "http://host.docker.internal:9222",
        "browser_chatgpt_url": "https://chatgpt.com",
        "browser_poll_interval_ms": 250,
        "browser_stable_seconds": 1.5,
        "browser_model_labels": {
          "chatgpt_auto": "",
          "chatgpt_instant": "Instant",
          "chatgpt_pro": "Pro",
          "chatgpt_thinking": "Thinking"
        },
        "browser_accounts": [],
        "proxy": null,
        "wss_proxy": null,
        "enable_arkose_endpoint": false,
        "arkose_endpoint_base": null,
        "common_timeout": 20,
        "ask_timeout": 600,
        "sync_conversations_on_startup": false,
        "sync_conversations_schedule": false,
        "sync_conversations_schedule_interval_hours": 12,
        "enabled_models": [
          "chatgpt_auto"
        ],
        "model_code_mapping": {
          "chatgpt_auto": "auto",
          "chatgpt_instant": "instant",
          "chatgpt_pro": "pro",
          "chatgpt_thinking": "thinking",
          "gpt_3_5": "text-davinci-002-render-sha",
          "gpt_3_5_mobile": "text-davinci-002-render-sha-mobile",
          "gpt_4": "gpt-4",
          "gpt_4_browsing": "gpt-4-browsing",
          "gpt_4_code_interpreter": "gpt-4-code-interpreter",
          "gpt_4_dalle": "gpt-4-dalle",
          "gpt_4_mobile": "gpt-4-mobile",
          "gpt_4_plugins": "gpt-4-plugins",
          "gpt_4o": "gpt-4o"
        },
        "file_upload_strategy": "browser_upload_only",
        "max_completion_concurrency": 1,
        "disable_uploading": true
      }
    },
    "openai_api": {
      "allOf": [
        {
          "$ref": "#/$defs/OpenaiApiSetting"
        }
      ],
      "default": {
        "enabled": true,
        "openai_base_url": "https://api.openai.com/v1/",
        "proxy": null,
        "connect_timeout": 10,
        "read_timeout": 20,
        "enabled_models": [
          "gpt_3_5",
          "gpt_4"
        ],
        "model_code_mapping": {
          "gpt_3_5": "gpt-3.5-turbo",
          "gpt_4": "gpt-4"
        }
      }
    },
    "common": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonSetting"
        }
      ],
      "default": {
        "print_sql": false,
        "print_traceback": true,
        "create_initial_admin_user": true,
        "initial_admin_user_username": "admin",
        "initial_admin_user_password": "password"
      }
    },
    "http": {
      "allOf": [
        {
          "$ref": "#/$defs/HttpSetting"
        }
      ],
      "default": {
        "host": "127.0.0.1",
        "port": 8000,
        "cors_allow_origins": [
          "http://localhost:8000",
          "http://localhost:5173",
          "http://127.0.0.1:8000",
          "http://127.0.0.1:5173"
        ]
      }
    },
    "data": {
      "allOf": [
        {
          "$ref": "#/$defs/DataSetting"
        }
      ],
      "default": {
        "data_dir": "./data",
        "database_url": "sqlite+aiosqlite:///data/database.db",
        "mongodb_url": "mongodb://cws:password@mongo:27017",
        "mongodb_db_name": "cws",
        "run_migration": true,
        "max_file_upload_size": 104857600
      }
    },
    "auth": {
      "allOf": [
        {
          "$ref": "#/$defs/AuthSetting"
        }
      ],
      "default": {
        "jwt_secret": "MODIFY_THIS_TO_RANDOM_SECURE_STRING",
        "jwt_lifetime_seconds": 259200,
        "cookie_max_age": 259200,
        "user_secret": "MODIFY_THIS_TO_ANOTHER_RANDOM_SECURE_STRING"
      }
    },
    "stats": {
      "allOf": [
        {
          "$ref": "#/$defs/StatsSetting"
        }
      ],
      "default": {
        "ask_stats_ttl": 7776000,
        "request_stats_ttl": 2592000,
        "request_stats_filter_keywords": [
          "/status"
        ]
      }
    },
    "log": {
      "allOf": [
        {
          "$ref": "#/$defs/LogSetting"
        }
      ],
      "default": {
        "console_log_level": "INFO"
      }
    }
  },
  "title": "ConfigModel",
  "type": "object"
}
