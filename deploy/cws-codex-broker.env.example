CWS_CODEX_HOST=127.0.0.1
CWS_CODEX_PORT=8765
CWS_CODEX_PRIMARY_AUTH=/var/lib/cws-codex/auth.json
CWS_CODEX_ACCOUNTS_DIR=/var/lib/cws-codex/accounts
CWS_CODEX_STATE_FILE=/var/lib/cws-codex/broker-state.json
CWS_CODEX_DEVICE_TOKEN_FILE=/var/lib/cws-codex/device-tokens.json
CWS_CODEX_RELEASE_DIR=/var/lib/cws-codex/releases
CWS_CODEX_LEASE_SECONDS=28800
CWS_CODEX_LEASE_ROTATION_SECONDS=86400
CWS_CODEX_REFRESH_WINDOW_SECONDS=900
CWS_CODEX_USAGE_CACHE_SECONDS=30
CWS_CODEX_MODEL_PROBE_INTERVAL_SECONDS=900
CWS_CODEX_MODEL_COOLDOWN_SECONDS=1800
CWS_CODEX_MODEL_PROBE_CONCURRENCY=2
CWS_CODEX_MODEL_PROBE_TIMEOUT_SECONDS=45
CWS_CODEX_MODEL_HEALTH_FILE=/var/lib/cws-codex/model-health.json
# Comma-separated Codex text models used only when remote discovery fails.
CWS_CODEX_MODEL_FALLBACKS=
# HTTPS is required outside the http://127.0.0.1 test exception.
CWS_CODEX_MODELS_URL=https://chatgpt.com/backend-api/codex/models
CWS_CODEX_RESPONSES_URL=https://chatgpt.com/backend-api/codex/responses
# Optional backwards-compatible static tokens. Prefer codex_device_tokens.py.
CWS_CODEX_DEVICE_TOKENS=
CWS_CODEX_ADMIN_TOKEN=replace-with-random-admin-token
# Used to deterministically rebuild self-service user tokens without storing plaintext.
# Keep stable after users are created. If omitted, CWS_CODEX_ADMIN_TOKEN is used.
CWS_CODEX_USER_TOKEN_SECRET=replace-with-another-random-token-at-least-32-characters
